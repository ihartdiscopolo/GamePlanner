<form action="/settings" method="post" class="form-group">
    <input type="hidden" name="field" value="profileUsername">
    <label for="username" class="form-label">Username</label>
    <div class="input-group">
        <input type="text" name="username" class="form-control" placeholder="Username" value="{{ profile.Username }}">   
        <button class="btn btn-main">Save</button>
    </div> 
</form>

<form action="/settings" method="post">
    <input type="hidden" name="field" value="profileColor">
    <label for="color" class="form-label">Color</label>
    <div class="input-group">
        <div class="color-viewer {{profile.Color}}"></div>
        
        <select name="color" class="form-control" onchange="this.form.requestSubmit()">
            <option value="green"  {% if profile.Color == "green"  %}selected{% endif %}>Green</option>
            <option value="red"    {% if profile.Color == "red"    %}selected{% endif %}>Red</option>
            <option value="yellow" {% if profile.Color == "yellow" %}selected{% endif %}>Yellow</option>
            <option value="blue"   {% if profile.Color == "blue"   %}selected{% endif %}>Blue</option>
            <option value="purple" {% if profile.Color == "purple" %}selected{% endif %}>Purple</option>
        </select>
    </div>
</form>

<div class="dropdown">
    <div class="drop-head" id="drop-head">
        <span>Pin</span>
        <span class="drop-arrow" id="drop-arrow">&lt;</span>
    </div>
    <div class="drop-body" id="drop-body">
        <form action="/settings" method="post" class="form-group" data-toggle-on-success=".hasProfilePin">
            <input type="hidden" name="field" value="profilePin">
            <div class="hasProfilePin" {% if not profile.Pin %} hidden {% endif %}>
                <label for="oldpin" class="form-label">Old pin</label>
                <div class="password-wrapper">
                    <input type="password" name="oldpin" class="form-control" placeholder="Old pin">
                    <button type="button" class="password-toggle" aria-label="Show password">
                        <span class="icon-eye" data-icon="open"></span>
                    </button>
                </div>
            </div>
            <label for="pin" class="form-label">New pin</label>
            <div class="password-wrapper">
                <input type="password" name="pin" class="form-control" placeholder="New pin">
                <button type="button" class="password-toggle" aria-label="Show password">
                    <span class="icon-eye" data-icon="open"></span>
                </button>
            </div>
            <label for="repin" class="form-label">Re-enter new pin</label>
            <div class="password-wrapper">
                <input type="password" name="repin" class="form-control" placeholder="Re-enter new pin">
                <button type="button" class="password-toggle" aria-label="Show password">
                    <span class="icon-eye" data-icon="open"></span>
                </button>
            </div>
            <button class="btn btn-main stretch">Save</button>
        </form>
    </div>
</div>

<div class="dropdown">
    <div class="drop-head" id="drop-head">
        <span>Delete profile</span>
        <span class="drop-arrow" id="drop-arrow">&lt;</span>
    </div>
    <div class="drop-body" id="drop-body">
        <form action="/settings" method="post" class="form-group">
            <input type="hidden" name="field" value="profileDelete">
            
            <div class="hasProfilePin" {% if not profile.Pin %} hidden {% endif %}>
                <label for="pin" class="form-label">Enter pin</label>
                <div class="password-wrapper">
                    <input type="password" name="pin" class="form-control" placeholder="Pin">
                    <button type="button" class="password-toggle" aria-label="Show password">
                        <span class="icon-eye" data-icon="open"></span>
                    </button>
                </div>
            </div>
            <button class="btn btn-outline stretch">Delete</button>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const colorSelect = document.querySelector('select[name="color"]');
        const colorViewer = document.querySelector('.color-viewer');
        const colorClasses = ['green', 'red', 'yellow', 'blue', 'purple'];

        function updateColorViewer() {
            colorViewer.classList.remove(...colorClasses);
            colorViewer.classList.add(colorSelect.value);
        }

        if (colorSelect && colorViewer) {
            colorSelect.addEventListener('change', updateColorViewer);
        }
    });
</script>