<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>gameplanner - {{ viewName }}</title>
        <link rel="stylesheet" href="/css/main.min.css">
        <link rel="stylesheet" href="/css/buttons.min.css">
        <link rel="stylesheet" href="/css/nav.min.css">
        {% for css_file in css %}
            <link rel="stylesheet" href="/css/{{ css_file }}.min.css">
        {% endfor %}
        <script src="/js/themeToggle.min.js"></script>
        {% for js_file in js %}
            <script src="/js/{{ js_file }}.min.js"></script>
        {% endfor %}
    </head>
    <body data-theme="dark">
        {% include 'templates/nav.twig' %}
        <div class="app-body">
            {% if session.profileLoggedIn == true %}
                <nav class="sidenav-wrap">
                    {% include 'templates/sideNav.twig' %}
                </nav>
            {% endif %}
            <main>
                {% include viewName ~ '.twig' %}
            </main>
        </div>
    </body>
</html>
