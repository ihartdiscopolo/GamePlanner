<div class="groceryContainer">
    <div class="groceryList">
        <h1>Grocery list</h1>
        <div class="groceryItem">
            {{ grocery.Name }}
            {{ grocery.DateAdded }}
            {{ grocery.Creator }}
            {{ grocery.Specification }}
            {{ grocery.amount }}
        </div>
    </div>
    <div class="addItem">
        <h1>Add item</h1>
        <form action="/grocery/add" method="post" class="form-group">
            <label for="name" class="form-label">Item name</label>
            <input type="text" name="name" id="name" class="form-control" placeholder="e.g. Milk" required>

            <label for="amount" class="form-label">Amount</label>
            <input type="text" name="amount" id="amount" class="form-control" placeholder="e.g. 2 liters">

            <label for="specification" class="form-label">Specification</label>
            <input type="text" name="specification" id="specification" class="form-control" placeholder="e.g. Whole, skim, etc.">

            <button type="submit" class="btn btn-main">Add item</button>
        </form> 
