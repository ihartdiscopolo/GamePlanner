<div id="container">
    <div id="profiles">
        
        {% for profile in profiles %}
            <a href="#">
                <div class="profile">
                    <img class="profileImage">
                    <div>
                        {{ profile.Username }}
                    </div>
                </div>
            </a>
        {% endfor %}
        
        <a class="btn-open-modal" data-target="Create">
            <div class="profile">
                <div class="profileImage">
                    <div class="profileImageIcon"></div>
                </div>
                <div>
                    Create
                </div>
            </div>
        </a>
    </div>
</div>

<div id="Create" class="modal modal-overlay">
    <div class="modal-dialog"> 
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create new profile</h5>
                <button type="button" class="btn-close">&times;</button>
            </div>

            <form action="create" method="post">
                <div class="modal-body">
                    <p>Create your new profile here.</p>
                </div>
                
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline btn-close">Close</button>
                    <button type="submit" class="btn btn-main">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>