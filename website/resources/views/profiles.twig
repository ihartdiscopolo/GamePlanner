                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="radioGroup" id="radio2">
                        <label class="form-check-label" for="radio2">Or toggle this other custom radio</label>
                    </div> #}

                </div>
                
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline btn-close">Close</button>
                    <button type="submit" class="btn btn-main">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>