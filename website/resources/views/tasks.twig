<div class="flex-layout">
    <div class="box box-fat" data-item-prefix="task">
        <div class="head">
            <h1><a href="/tasks">Tasks</a></h1>
            
            <form action="/tasks" method="get" class="filter-form" data-no-ajax>
                <label for="categoryFilter" class="form-label">Category</label>
                <select name="filterCategory" id="categoryFilter" class="form-control" onchange="this.form.submit()">
                    <option value="0" {% if categoryFilter == 0 %}selected{% endif %}>All categories</option>
                    {% for category in categories %}
                        <option value="{{ category.Id }}" {% if category.Id == categoryFilter %}selected{% endif %}>{{ category.Name }}</option>
                    {% endfor %}
                </select>

                <span class="filter-divider"></span>

                <label for="sortOrder" class="form-label">Sort</label>
                <select name="sortOrder" id="sortOrder" class="form-control" onchange="this.form.submit()">
                    <option value="newest" {% if sortOrder == 'newest' %}selected{% endif %}>Newest deadline</option>
                    <option value="oldest" {% if sortOrder == 'oldest' %}selected{% endif %}>Oldest deadline</option>
                    <option value="alpha" {% if sortOrder == 'alpha' %}selected{% endif %}>Alphabetical A–Z</option>
                    <option value="alpha_desc" {% if sortOrder == 'alpha_desc' %}selected{% endif %}>Alphabetical Z–A</option>
                </select>
            </form>
        </div>

        {% for task in tasks %}
            <div class="taskItem {% if task.Completed %}completed{% endif %}">
                <div class="taskDetails">
                    <div class="dropdown" id="task-{{task.Id}}">
                        <div class="drop-head">
                            <span>{{ task.Name }}</span>
                            <span class="drop-arrow" id="drop-arrow">&lt;</span>
                        </div>
                        <div class="drop-body">
                            <div class="drop-body-inner">
                                <div class="meta-grid">
                                    {% if task.Coins %}
                                    <div class="meta-item">
                                        <div class="meta-label">Coins reward</div>
                                        <div class="meta-value">{{ task.Coins }}</div>
                                    </div>
                                    {% endif %}
                                    {% if task.CategoryName %}
                                    <div class="meta-item">
                                        <div class="meta-label">Category</div>
                                        <div class="meta-value">{{ task.CategoryName }}</div>
                                    </div>
                                    {% endif %}
                                    {% if task.AssignedToName %}
                                    <div class="meta-item">
                                        <div class="meta-label">Assigned to</div>
                                        <div class="meta-value">{{ task.AssignedToName }}</div>
                                    </div>
                                    {% endif %}
                                    {% if task.Deadline %}
                                    <div class="meta-item">
                                        <div class="meta-label">Deadline</div>
                                        <div class="meta-value">{{ task.Deadline }}</div>
                                    </div>
                                    {% endif %}
                                    {% if task.Info %}
                                    <div class="meta-item">
                                        <div class="meta-label">Info</div>
                                        <div class="meta-value">{{ task.Info }}</div>
                                    </div>
                                    {% endif %}
                                </div>
                                {% if profile.Can_Edit_Tasks or profile.Is_Creator %}
                                    <div class="actions">
                                        <form action="/tasks/delete" method="post" data-remove-on-success=".taskItem">
                                            <input type="hidden" name="id" value="{{ task.Id }}">
                                            <button type="submit" class="btn btn-outline">Remove</button>
                                        </form>
                                        <form action="/tasks/toggle" method="post">
                                            <input type="hidden" name="id" value="{{ task.Id }}">
                                            <button type="submit" class="btn btn-outline">{% if task.Completed %}Uncomplete{% else %}Complete{% endif %}</button>
                                        </form>
                                        <a href="/tasks/edit/{{ task.Id }}" class="btn btn-main">Edit</a>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    {% if profile.Can_Edit_Tasks or profile.Is_Creator %}
        <div class="box box-slim">
            <div class="head">
                <h1>Add task</h1>
            </div>
            <form action="/tasks/add" method="post" class="form-group">
                <label for="name" class="form-label">Task name</label>
                <input type="text" name="name" id="name" class="form-control" placeholder="e.g. Take out trash" required>

                <label for="category" class="form-label">Category</label>
                <select name="category" id="category" class="form-control" required>
                    <option value="" disabled selected>Select a category</option>
                    {% for category in categories %}
                        <option value="{{ category.Id }}">{{ category.Name }}</option>
                    {% endfor %}
                </select>

                <label for="assignedTo" class="form-label">Assign to</label>
                <select name="assignedTo" id="assignedTo" class="form-control">
                    <option value="">Unassigned</option>
                    {% for member in householdMembers %}
                        <option value="{{ member.Id }}">{{ member.Username }}</option>
                    {% endfor %}
                </select>

                <label for="deadline" class="form-label">Deadline</label>
                <input type="date" name="deadline" id="deadline" class="form-control">

                <label for="info" class="form-label">Info</label>
                <textarea name="info" id="info" class="form-control" placeholder="Optional details"></textarea>

                <label for="coins" class="form-label">Coins (worth)</label>
                <input type="number" name="coins" id="coins" class="form-control" min="0" value="0" required>

                <button type="submit" class="btn btn-main stretch">Add task</button>
            </form>
        </div>
    {% endif %}
</div>