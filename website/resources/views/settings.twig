<div class="settings box box-fat">
    <div class="title">
        <h1>Settings</h1>
    </div>
    <div class="settingsNav">
        <a href="/settings/profile" class="{{ currentPath == '/settings/profile' ? 'active' : '' }}">
            <span class="icon" style="--icon-url: url('/images/icon_profile.svg')"></span>
            <span class="label">Profile</span>
        </a>
        <a href="/settings/household" class="{{ currentPath == '/settings/household' ? 'active' : '' }}">
            <span class="icon" style="--icon-url: url('/images/icon_profile.svg')"></span>
            <span class="label">Household</span>
        </a>
        <a href="/settings/permisions" class="{{ currentPath == '/settings/permisions' ? 'active' : '' }}">
            <span class="icon" style="--icon-url: url('/images/icon_profile.svg')"></span>
            <span class="label">Permisions</span>
        </a>
    </div>
    <div class="body">
        {% if currentPath == '/settings/profile' %}
            {% include '/settings/profile.twig' %}
        {% endif %}
        {% if currentPath == '/settings/household' %}
            {% include '/settings/household.twig' %}
        {% endif %}
        {% if currentPath == '/settings/permisions' %}
            {% include '/settings/permisions.twig' %}
        {% endif %}
    </div>
</div>