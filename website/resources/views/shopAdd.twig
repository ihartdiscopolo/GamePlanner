<div class="box box-slim">
    <div class="page-header">
        <h1>Add Shop Item</h1>
        <a href="/shop/manage" class="btn btn-outline">Back</a>
    </div>

    <form action="/shop/add" method="post" class="form-group">
        <label for="name" class="form-label">Item name *</label>
        <input type="text" name="name" id="name" class="form-control" placeholder="e.g. Bonus life" required>

        <label for="description" class="form-label">Description</label>
        <textarea name="description" id="description" class="form-control" placeholder="Optional description"></textarea>

        <label for="ticket_price" class="form-label">Ticket price</label>
        <input type="number" name="ticket_price" id="ticket_price" class="form-control" min="0" value="0">

        <label for="coin_price" class="form-label">Coin price</label>
        <input type="number" name="coin_price" id="coin_price" class="form-control" min="0" value="0">

        <button type="submit" class="btn btn-main stretch">Add item</button>
        <a href="/shop/manage" class="btn btn-outline stretch">Cancel</a>
    </form>
</div>