<header class="nav">
    <div class="nav-left">
        {% if session.profileLoggedIn == true %}
            <div class="hamburger-btn-div">
                <button id="openNavBtn" type="button" class="hamburger-btn" aria-label="Toggle navigation" aria-expanded="false">
                    <svg class="hamburger-icon" viewBox="0 0 100 60"
                        xmlns="http://www.w3.org/2000/svg" fill="currentColor">
                        <rect class="line line-top" x="5" y="3.5" width="90" height="9" rx="4.5"/>
                        <rect class="line line-mid" x="5" y="25.5" width="75" height="9" rx="4.5"/>
                        <rect class="line line-bottom" x="5" y="47.5" width="60" height="9" rx="4.5"/>
                    </svg>
                </button>
            </div>
        {% endif %}

        <a href="/" class="logo">
            <img id="logo" height="60px" src="/images/Light_logo.svg">
        </a>
    </div>

    <div class="text-end">
        {% if session.householdLoggedIn == false %}
            <a href="/login" class="btn btn-outline">Login</a>
            <a href="/register" class="btn btn-main">Sign-up</a>
        {% elseif  session.householdLoggedIn == true and session.profileLoggedIn == false %}
            <form action="/logout" method="post">
                <button type="submit" class="btn btn-outline">Logout</button>
            </form>
        {% else %}
            <div class="stat">
                <span class="stat-icon" style="--icon-url: url('/images/icon_coin.svg')"></span>
                <span>{{ profile.Coins }}</span>
            </div>
            <div class="stat">
                <span class="stat-icon" style="--icon-url: url('/images/icon_ticket.svg')"></span>
                <span>{{ profile.Tickets }}</span>
            </div>
        {% endif %}

        {% if session.householdLoggedIn == false or session.householdLoggedIn == true and session.profileLoggedIn == false %}
            <button id="theme-toggle" class="btn btn-outline theme-toggle">
                <span id="theme-icon" style="--icon-url: url('/images/icon_moon.svg')" alt="Toggle Theme"></span>
            </button>
        {% endif %}
    </div>
</header>