<header class="nav">
    <div>
        {% if session.profileLoggedIn == false %}
            <img height="60px" onclick="openNav()" src="/images/icon_hamber.svg">
        {% endif %}

        <a href="/" class="logo">
            <img height="60px" src="/images/Light_logo.svg">
        </a>
    </div>

    <div class="text-end">
        {% if session.householdLoggedIn == false %}
            <a href="/login" class="btn btn-outline">Login</a>
            <a href="/register" class="btn btn-main">Sign-up</a>
        {% else %}
            <form action="logout" method="post">
                <button type="submit" class="btn btn-outline">Logout</button>
            </form>
        {% endif %}
    </div>
</header>

{% if session.profileLoggedIn == false %}
    {% include 'templates/sideNav.twig' %}
{% endif %}