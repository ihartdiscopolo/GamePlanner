<div class="box box-fat">
    <div class="page-header">
        <h1>Edit Shop Item</h1>
    </div>

    <form action="/shop/edit" method="post" class="form-group">
        <input type="hidden" name="id" value="{{ item.id }}">

        <label for="name" class="form-label">Item name *</label>
        <input type="text" name="name" id="name" class="form-control" value="{{ item.name }}" required>

        <label for="description" class="form-label">Description</label>
        <textarea name="description" id="description" class="form-control">{{ item.description }}</textarea>

        <label for="ticket_price" class="form-label">Ticket price</label>
        <input type="number" name="ticket_price" id="ticket_price" class="form-control" min="0" value="{{ item.ticket_price }}">

        <label for="coin_price" class="form-label">Coin price</label>
        <input type="number" name="coin_price" id="coin_price" class="form-control" min="0" value="{{ item.coin_price }}">

        <button type="submit" class="btn btn-main stretch">Save changes</button>
        <a href="/shop" class="btn btn-outline stretch">Cancel</a>
    </form>
</div>